# EST8 CallDesk server settings.
# In Google AI Studio, add each of these under Settings -> Secrets (never in front-end code).
# Locally, copy this file to .env and fill it in. .env is git-ignored.

# ---------------- App ----------------
# The public address of the app. Twilio webhooks and sign-in use it.
APP_URL="https://est8-calldesk.ai.studio"

# Google accounts that become admins the first time they sign in (comma-separated).
# Everyone else must be invited by an admin from the Team screen.
ADMIN_EMAILS="you@example.com"

# ---------------- Firebase (Google sign-in + Firestore database) ----------------
# Firebase Console -> Project settings -> General -> Your apps -> Web app config.
FIREBASE_API_KEY=""
FIREBASE_PROJECT_ID=""
# Optional. Defaults to <project-id>.firebaseapp.com
FIREBASE_AUTH_DOMAIN=""
# Optional.
FIREBASE_APP_ID=""

# Optional. Only needed when the app runs outside the Firebase project's Google Cloud project.
# Firebase Console -> Project settings -> Service accounts -> Generate new private key.
# Paste the whole JSON file on one line.
FIREBASE_SERVICE_ACCOUNT=""

# ---------------- Twilio (calling and texting) ----------------
# Twilio Console home page -> Account Info.
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""

# Twilio Console -> Account -> API keys & tokens -> Create API key (Standard).
# The SID starts with SK. The secret is shown only once.
TWILIO_API_KEY=""
TWILIO_API_SECRET=""

# Twilio Console -> Voice -> Manage -> TwiML Apps. Starts with AP.
# Set the app's Voice Request URL to  <APP_URL>/api/telephony/voice/outbound  (POST).
TWILIO_TWIML_APP_SID=""

# Optional until you text. Twilio Console -> Messaging -> Services. Starts with MG.
# Needs an approved A2P 10DLC campaign before carriers deliver texts.
TWILIO_MESSAGING_SERVICE_SID=""

# Optional. A Twilio number (+1XXXXXXXXXX) to use when an agent has no number for the lead's state.
TWILIO_DEFAULT_CALLER_ID=""

# Optional. "true" lets agents (not just admins) buy Twilio numbers from the app.
ALLOW_AGENT_NUMBER_PURCHASE="false"
